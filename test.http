@baseUrl = http://127.0.0.1:8000

# Start the API first:  make api   (or: uvicorn app.api:app --reload)
#
# Routes covered here:
#   GET  /health         explicit route
#   POST /chat           explicit route (question, debug, use_rerank)
#   GET  /docs           Swagger UI, generated by FastAPI
#   GET  /redoc          ReDoc, generated by FastAPI
#   GET  /openapi.json   OpenAPI schema, generated by FastAPI

############################################################
# GET /health
############################################################

### Health check
GET {{baseUrl}}/health

############################################################
# POST /chat - the full RAG pipeline
############################################################

### Chat: question with an answer
POST {{baseUrl}}/chat
Content-Type: application/json

{
  "question": "Qual é o SLA para incidentes P1 no plano Enterprise?"
}

### Chat: with debug (query plan, retrieved chunks, selected chunks, timings, tokens, policy)
POST {{baseUrl}}/chat
Content-Type: application/json

{
  "question": "Qual é o SLA para incidentes P1 no plano Enterprise?",
  "debug": true
}

### Chat: without reranking (uses the top 4 of the retrieval)
POST {{baseUrl}}/chat
Content-Type: application/json

{
  "question": "Quais formas de pagamento o FCAI Cloud aceita?",
  "use_rerank": false,
  "debug": true
}

### Chat: no plan named, the answer covers the three plans
POST {{baseUrl}}/chat
Content-Type: application/json

{
  "question": "O que acontece se eu ultrapassar a cota de ingestão?"
}

### Chat: ambiguous question (returns needs_clarification=true)
POST {{baseUrl}}/chat
Content-Type: application/json

{
  "question": "Como funciona o suporte no plano da empresa?"
}

### Chat: answer not in the knowledge base (has_answer=false, sources=[])
POST {{baseUrl}}/chat
Content-Type: application/json

{
  "question": "Qual é a capital da França?"
}

### Chat: blocked by governance policy (200, has_answer=false, sources=[])
# Not triggered by the request: start the API with a policy that blocks, e.g.
#   make api POLICY=model   -> AI_ALLOWED_MODELS does not include OPENAI_CHAT_MODEL
#   make api POLICY=budget  -> AI_MONTHLY_BUDGET_USD=0
# Then send any question, with debug to see the policy block:
POST {{baseUrl}}/chat
Content-Type: application/json

{
  "question": "Qual é o SLA para incidentes P1 no plano Enterprise?",
  "debug": true
}

### Chat: empty question (returns 400)
POST {{baseUrl}}/chat
Content-Type: application/json

{
  "question": "   "
}

### Chat: missing "question" field (returns 422, FastAPI validation)
POST {{baseUrl}}/chat
Content-Type: application/json

{
  "debug": true
}

### Chat: wrong method on /chat (returns 405, only POST is allowed)
GET {{baseUrl}}/chat

############################################################
# Routes generated by FastAPI
############################################################

### Swagger UI (open in the browser: {{baseUrl}}/docs)
GET {{baseUrl}}/docs

### ReDoc (open in the browser: {{baseUrl}}/redoc)
GET {{baseUrl}}/redoc

### OpenAPI schema
GET {{baseUrl}}/openapi.json
